generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())
}

model NewsArticle {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  category        String
  categoryId      String?
  excerpt         String?
  content         String?
  imageUrl        String?
  imageAlt        String?
  imageCaption    String?
  ogImageUrl      String?
  ogImageAlt      String?
  status          ArticleStatus @default(DRAFT)
  tags            String[]
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  canonicalUrl    String?
  authorName      String?
  robotsIndex     Boolean       @default(true)
  robotsFollow    Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categoryRecord NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

model NewsCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  nameEn          String?
  slugEn          String?  @unique
  descriptionEn   String?
  metaTitle       String?
  metaDescription String?
  metaTitleEn     String?
  metaDescriptionEn String?
  canonicalUrl    String?
  canonicalUrlEn  String?
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  articles NewsArticle[]
}

model DashboardIntegration {
  id        String              @id @default(cuid())
  category  IntegrationCategory
  provider  String
  enabled   Boolean             @default(false)
  config    Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([category, provider])
  @@index([category])
}

enum IntegrationCategory {
  PAYMENT
  SHIPPING
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model MediaAsset {
  id            String   @id @default(cuid())
  originalName  String
  originalFile  String
  optimizedFile String
  mime          String
  width         Int
  height        Int
  sizeBytes     Int
  altText       String   @default("")
  caption       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  categoryId      String
  description     String        @default("")
  contentHtml     String        @default("") @db.Text
  summaryHtml     String        @default("") @db.Text
  priceText       String        @default("Liên hệ")
  stockText       String        @default("Còn hàng")
  imageUrl        String        @default("")
  imageAlt        String        @default("")
  imageCaption    String        @default("")
  shipperImageUrl String        @default("")
  ogImageUrl      String        @default("")
  ogImageAlt      String        @default("")
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean       @default(true)
  robotsFollow    Boolean       @default(true)
  isPublished     Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gallery         ProductMedia[]
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, isPublished, sortOrder])
}

model ProductCategory {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @default("")
  nameEn            String
  slugEn            String   @unique
  descriptionEn     String   @default("")
  imageUrl          String   @default("")
  imageAlt          String   @default("")
  imageCaption      String   @default("")
  imageAltEn        String   @default("")
  imageCaptionEn    String   @default("")
  metaTitle         String?
  metaDescription   String?
  metaTitleEn       String?
  metaDescriptionEn String?
  canonicalUrl      String?
  canonicalUrlEn    String?
  robotsIndex       Boolean  @default(true)
  robotsFollow      Boolean  @default(true)
  isPublished       Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products Product[]
}

model TranslationEntry {
  id              String            @id @default(cuid())
  entityType      TranslationEntity
  entityId        String
  locale          String            @default("en")
  slug            String?
  payload         Json
  sourceUpdatedAt DateTime
  sourceHash      String
  status          TranslationStatus @default(PENDING)
  provider        String?
  errorMessage    String?
  manualOverride  Boolean           @default(false)
  translatedAt    DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([entityType, entityId, locale])
  @@unique([entityType, locale, slug])
}

enum TranslationEntity {
  PRODUCT
  NEWS_ARTICLE
  SITE_PAGE
  SITE_CONTENT
  SITE_CHROME
}

enum TranslationStatus {
  PENDING
  TRANSLATED
  NEEDS_REVIEW
  FAILED
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String  @default("")
  caption   String  @default("")
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model SitePage {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  title           String
  excerpt         String?
  sections        Json
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean      @default(true)
  robotsFollow    Boolean      @default(true)
  status          ArticleStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, updatedAt])
}

model SiteContentPage {
  id              String   @id @default(cuid())
  pageKey         String   @unique
  name            String
  route           String
  h1              String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dynamicContents SiteDynamicContent[]

  @@index([route])
}

model SiteDynamicContent {
  id          String   @id @default(cuid())
  pageKey     String
  sectionKey  String
  fieldKey    String
  label       String
  value       String   @default("")
  contentType String   @default("TEXT")
  headingLevel String?
  imageUrl    String?
  altText     String?
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page        SiteContentPage @relation(fields: [pageKey], references: [pageKey], onDelete: Cascade)

  @@unique([pageKey, sectionKey, fieldKey])
  @@index([pageKey, sortOrder])
}

enum SiteChromeArea {
  HEADER
  FOOTER
}

enum SiteChromeKind {
  DYNAMIC
  STATIC
}

model SiteChromeContent {
  id          String         @id @default(cuid())
  area        SiteChromeArea
  kind        SiteChromeKind @default(DYNAMIC)
  sectionKey  String
  fieldKey    String
  label       String
  value       String         @default("")
  url         String?
  imageUrl    String?
  altText     String?
  isVisible   Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([area, sectionKey, fieldKey])
  @@index([area, kind, sortOrder])
}

